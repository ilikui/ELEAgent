{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELEAgent hardware-to-AUTOSAR traceability record set",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement",
          "hardware",
          "chip",
          "autosar",
          "software",
          "verification",
          "confidence",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "object"
          },
          "hardware": {
            "type": "object"
          },
          "chip": {
            "type": "object"
          },
          "autosar": {
            "type": "object"
          },
          "software": {
            "type": "object"
          },
          "verification": {
            "type": "object"
          },
          "confidence": {
            "enum": [
              "unverified",
              "low",
              "medium",
              "high"
            ]
          },
          "status": {
            "type": "string"
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
